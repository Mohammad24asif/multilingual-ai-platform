# Copy to .env (repository root or backend/). Every variable is optional; defaults are shown.

# "research" allows research-only licences (NLLB-200, CC-BY-NC). "commercial" allows only verified permissive ones.
MLAI_LICENCE_MODE=research

# Where to run models: auto | cpu | cuda. A GPU is never required.
MLAI_DEVICE=auto

# Model weights are never downloaded implicitly. Use scripts/download_models.py, or set this to true to allow it.
MLAI_ALLOW_MODEL_DOWNLOAD=false

# Refuse pickle-based weight files (only safetensors). Safer, but some repositories only ship pickle files.
MLAI_REQUIRE_SAFETENSORS=false

# Comma-separated model ids to enable (empty = registry defaults). Example once IndicTrans2 has passed its check:
# MLAI_ENABLED_MODELS=indictrans2-indic-en-dist-200m,indictrans2-en-indic-dist-200m,nllb-200-distilled-600m
MLAI_ENABLED_MODELS=

# Remote model code that a human has reviewed, as repo@commit (see scripts/review_remote_code.py).
MLAI_REMOTE_CODE_ALLOWLIST=

# Memory limits and queue (uncomment to use)
# MLAI_RAM_BUDGET_MB=6000
# MLAI_TORCH_THREADS=4
MLAI_MAX_LOADED_MODELS=1
MLAI_INFERENCE_QUEUE_SIZE=8
MLAI_INFERENCE_TIMEOUT_S=120

# Input limits
MLAI_MAX_INPUT_CHARS=20000
MLAI_MAX_SEGMENTS=400
MLAI_MAX_REQUEST_BYTES=1000000

# Web
MLAI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MLAI_LOG_LEVEL=INFO
MLAI_LOG_JSON=true

# Database (SQLite for local use; keep the URL form so PostgreSQL can be swapped in later)
MLAI_DATABASE_URL=sqlite:///./data/local/app.sqlite3

# Optional: Hugging Face token (needed for gated repositories such as IndicTrans2). Never commit it.
# HF_TOKEN=
